# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB ───────────────────────────────────────────────────────────────
# Atlas connection string (Database -> Connect -> Drivers), or a local
# mongod URI for development, e.g. mongodb://localhost:27017/ekishaan
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ekishaan

# ── Auth (JWT) ────────────────────────────────────────────────────────────
# Generate strong random secrets, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-at-least-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ── Cross-service URLs ────────────────────────────────────────────────────
# The deployed frontend origin (Vercel). Used for CORS allow-listing and to
# build the links inside password-setup/reset emails.
FRONTEND_URL=http://localhost:5173
# The Python FastAPI ML microservice (HACKATHON/ml_backend).
ML_BACKEND_URL=http://localhost:8000

# ── Email (optional but required for "forgot password" / migrated-account
# setup emails to actually send — without these, links are logged to the
# console instead, which is fine for local dev) ─────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
