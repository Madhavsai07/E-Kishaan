# Only needed once, to run: npm run migrate:supabase
# Copy to backend/.env alongside the vars in ../.env.example (the migration
# script also needs MONGODB_URI, FRONTEND_URL, and — optionally — the
# EMAIL_* vars from the main .env to actually send setup-link emails).

# Supabase project (Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
# The SECRET service_role key (NOT the anon key) — required to read
# auth.users via the Admin API and to bypass RLS on the profiles table.
# Treat this like a root password: never commit it, never expose it to a
# browser, and only ever use it from this one-off script.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
