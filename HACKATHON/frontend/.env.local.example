# Copy this file to .env.local and fill in the values for your setup.

# The Express backend (HACKATHON/backend). Required — without it, every
# soil/roadmap/crop/auth API call fails once this frontend is deployed on a
# different origin than the backend (e.g. Vercel + Render).
# Local dev:  http://localhost:5000
# Production: https://your-backend-service.onrender.com
VITE_API_URL=http://localhost:5000

# The Python FastAPI ML microservice (HACKATHON/ml_backend) — used directly
# by the Market Prediction tab.
# Local dev:  http://localhost:8000
# Production: https://your-ml-backend-service.onrender.com
VITE_ML_BACKEND_URL=http://localhost:8000
