# Optional. The app already defaults to the shared AgriSmart Supabase
# project (see src/lib/supabase.ts) so it works out of the box with no setup.
#
# Only create a .env.local from this file if you want to point the app at a
# *different* Supabase project (e.g. your own, for isolated testing). Find
# these values in your Supabase project: Project Settings -> API. If you do,
# remember to also run supabase/schema.sql against that project.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
